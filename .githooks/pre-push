#!/bin/sh
# ── Il collaudo del sito, prima che il codice esca da qui ───────────────────
#
# 🔴 **Esiste perché la CI è verde mentre il collaudo è rosso** (TD-97, misurato
# il 2026-08-12): `.github/workflows/ci.yml` esegue lint + build + audit a11y,
# **non** `scripts/collaudo.mjs` — che è il presidio serio, perché *esercita* le
# pagine invece di guardarle. Ha preso i difetti del 7 agosto; la CI no.
#
# ⚠️ E non è teoria: la sera stessa in cui questo hook è stato scritto, il
# collaudo ha trovato **tre regressioni introdotte quel giorno** che lint, build
# e audit a11y non avevano visto — una violazione WCAG *serious* sul contatore
# del widget (`--fg-faint` a 14px, 4,41 contro 4,5) e due sezioni oltre la
# schermata su telefono. Nessuna sarebbe uscita da un controllo statico.
#
# ⛔ Perché un hook e non la CI: la CI **non parte**, la fatturazione GitHub è
# bloccata (TD-83). Un presidio che gira solo dove non gira nessuno non è un
# presidio. Quando la CI tornerà, questo va nel workflow e l'hook resta come
# rete locale — non si sostituiscono, si sommano.
#
# Per saltarlo una volta:  COLLAUDO=0 git push
set -e

[ "$COLLAUDO" = "0" ] && { echo "⏭️  collaudo saltato (COLLAUDO=0)"; exit 0; }

RADICE=$(cd "$(dirname "$0")/.." && pwd)
cd "$RADICE"

# Solo se stanno uscendo cose che cambiano ciò che si vede.
if git diff --quiet HEAD @{push} -- src scripts 2>/dev/null; then
  exit 0
fi

# ── LE TRADUZIONI DEL MANUALE ───────────────────────────────────────────────
#
# ⚠️ PRIMA del controllo su `out/`, e di proposito: questo legge i SORGENTI, non
# il costruito, quindi funziona anche a `out/` assente e non costa niente.
#
# 🔑 Prende la cosa che il resto del collaudo non puo' vedere: una traduzione
# **scaduta**. Il manuale italiano cambia, le altre quattro lingue no, e non si
# vede — la pagina si apre, l'indice e' completo, i titoli sono nella lingua
# giusta, e il capitolo racconta una schermata che non esiste piu'. Un manuale
# che mente e' peggio di un manuale che manca.
if ! node scripts/manuale-lingue.mjs; then
  echo
  echo "⛔ PUSH BLOCCATO: traduzioni del manuale piu' vecchie dell'italiano."
  echo "   node scripts/traduci-manuale.mjs --lingua=<xx> --solo=<slug>"
  echo "   Serve LLM_API_KEY (la stessa del prodotto)."
  echo "   Emergenza: COLLAUDO=0 git push"
  exit 1
fi

# ── LE CINQUE LINGUE DEL SITO, dai SORGENTI ─────────────────────────────────
#
# 🔴 PERCHE' E' QUI. Il presidio vero della traduzione
# (`scripts/lingue-tradotte.mjs`) misura il **testo delle pagine costruite**, ma
# vuole il costruito in cinque lingue: ~20 minuti su questa macchina.
# Pretenderlo a ogni push vorrebbe dire un cancello che si salta sempre, ⛔ cioe'
# nessun cancello — ed e' precisamente il modo in cui questo progetto ha perso
# tre presidi (TD-148, TD-159, e i due su `STATE.md`).
#
# ⇒ qui gira quello che legge i **sorgenti**: costa meno di un secondo e prende
#   le tre regressioni che succedono davvero mentre si scrive — una stringa nuova
#   scritta nel codice invece che nel dizionario, una chiave aggiunta in italiano
#   e non nelle altre quattro, un dizionario copiato dall'italiano.
#
# ⚠️ E NON dice di aver guardato tutto: piu' sotto, quando `out/` non e' il
#    costruito a cinque lingue, l'hook **dichiara quale controllo non ha girato**.
#    Un presidio che tace su cio' che non ha guardato e' il difetto che questo
#    lavoro e' nato per chiudere.
if ! node scripts/lingue-sorgenti.mjs; then
  echo
  echo "⛔ PUSH BLOCCATO: la traduzione del sito è regredita."
  echo "   · stringa nuova scritta nel codice ⇒ mettila in src/i18n/sito/it.json"
  echo "     e usala con t('chiave')"
  echo "   · chiave presente in italiano e non nelle altre quattro lingue ⇒"
  echo "     node scripts/traduci-sito.mjs --riprendi   (serve LLM_API_KEY)"
  echo "   ⛔ NON alzare le soglie dentro lo script: sono il lavoro che misurano."
  echo "   Emergenza: COLLAUDO=0 git push"
  exit 1
fi

if [ ! -d out ]; then
  echo "⚠️  \`out/\` non c'è: costruisci prima (\`npm run build\`), oppure COLLAUDO=0."
  exit 1
fi

# ── E IL PRESIDIO SUL TESTO COSTRUITO, se il costruito c'è ───────────────────
#
# ⚠️ Gira **solo** se `out/` e' il costruito a cinque lingue: un `npm run build`
# semplice produce 41 pagine di solo italiano, e misurare quello direbbe niente.
# ⛔ Se non c'e', NON si tace: si dice quale controllo non ha girato e come farlo.
# 🔑 E' il presidio che ha sostituito il confronto sui byte — quello che passava
#    mentre la prosa era italiana.
if [ "$(find out -name '*.html' | wc -l | tr -d ' ')" -ge 100 ]; then
  if ! node scripts/lingue-tradotte.mjs; then
    echo
    echo "⛔ PUSH BLOCCATO: nel costruito ci sono pagine ancora in italiano."
    echo "   Guarda quali frasi elenca: vanno nel dizionario."
    echo "   Emergenza: COLLAUDO=0 git push"
    exit 1
  fi
else
  echo "⚠️  \`lingue-tradotte\` NON eseguito: out/ ha solo l'italiano (41 pagine)."
  echo "    ⛔ Quindi il testo delle pagine tradotte NON è stato verificato."
  echo "    Per verificarlo:  node scripts/costruisci-lingue.mjs"
fi

# ⚠️ Il server lo accende e lo spegne l'hook: un collaudo che dipende da un
# server acceso a mano è un collaudo che non gira.
PORTA=3211
python3 -m http.server "$PORTA" --bind 127.0.0.1 --directory out >/dev/null 2>&1 &
SERVER=$!
trap 'kill $SERVER 2>/dev/null || true' EXIT

# ⚠️ Si aspetta che il server RISPONDA, non due secondi. Un'attesa a tempo fisso
# misura la macchina, non il server: il 2026-08-12 con la macchina carica non
# bastavano, il collaudo moriva su `ERR_CONNECTION_REFUSED` e — vedi sotto —
# l'hook lo leggeva come «zero problemi».
for _ in $(seq 1 40); do
  curl -s -o /dev/null --max-time 2 "http://127.0.0.1:$PORTA/" && break
  sleep 1
done

# ── La cricca ───────────────────────────────────────────────────────────────
# ⛔ NON si pretende zero: il collaudo ha problemi preesistenti, e un presidio
# rosso dal primo giorno viene spento — in questo repo è già successo due volte
# (sta scritto in `scripts/tappe-alte.json`). Qui passa se il numero non SALE.
echo "🔎 collaudo del sito…"
# ⚠️ `set +e` attorno: con `errexit` attivo un'assegnazione il cui comando
# fallisce **uccide lo script**, e la riga dopo — quella che legge il codice —
# non viene mai eseguita. Risultato misurato: l'hook moriva in silenzio dopo
# aver stampato «collaudo del sito…», e il push falliva senza dire perche'.
set +e
USCITA=$(node scripts/collaudo.mjs "http://127.0.0.1:$PORTA" 2>&1)
CODICE=$?
set -e
echo "$USCITA"

TETTO=$(node -e "process.stdout.write(String(require('./scripts/collaudo-cricca.json').massimo))")
PULITA=$(printf '%s' "$USCITA" | sed 's/\x1b\[[0-9;]*m//g')

# 🔴 **Il difetto che questo blocco chiude, trovato il 2026-08-12 su me stesso.**
# Prima si faceva `|| true` sul comando e si contava con `|| echo 0`. Quando il
# collaudo **moriva** (server non ancora pronto), l'uscita non conteneva nessuna
# riga «N problemi», il conteggio cadeva a **0**, e l'hook stampava
# «✅ 0 problemi, come la cricca» — cioè **verde perché non aveva misurato
# niente**. E' lo schema che questo progetto ha gia' preso piu' volte: un
# presidio che guarda una tabella vuota e dice che va tutto bene.
# ⇒ Si pretende una PROVA che il collaudo sia arrivato in fondo.
if ! printf '%s' "$PULITA" | grep -qE '^[0-9]+ problemi:|Nessun problema'; then
  echo ""
  echo "⛔ Il collaudo non e' arrivato in fondo (uscita $CODICE): niente conteggio da"
  echo "   confrontare. NON e' «zero problemi» — e' una misura che non c'e'."
  exit 1
fi

if printf '%s' "$PULITA" | grep -q 'Nessun problema'; then
  TROVATI=0
else
  TROVATI=$(printf '%s' "$PULITA" | grep -oE '^[0-9]+ problemi:' | grep -oE '^[0-9]+')
fi

if [ "$TROVATI" -gt "$TETTO" ]; then
  echo ""
  echo "⛔ $TROVATI problemi, la cricca ne ammette $TETTO: ne hai introdotto uno NUOVO."
  echo "   Chiudilo. ⛔ Non alzare il numero in scripts/collaudo-cricca.json:"
  echo "   è il gesto con cui i presidi si perdono."
  exit 1
fi

if [ "$TROVATI" -lt "$TETTO" ]; then
  echo ""
  echo "✅ $TROVATI problemi contro $TETTO: ABBASSA \`massimo\` in scripts/collaudo-cricca.json"
  echo "   a $TROVATI, e scrivi lì quali hai chiuso. La cricca scende solo a mano."
  exit 1
fi

echo "✅ collaudo: $TROVATI problemi, come la cricca"
